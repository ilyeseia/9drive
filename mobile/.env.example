# Copy to .env (never commit .env). EXPO_PUBLIC_* values are embedded in the app bundle and are PUBLIC:
# never put a secret, token, or key here.
#
# API origin of your 9Drive backend.
#  - Release builds: must be https://
#  - Android emulator reaching a backend on your computer: http://10.0.2.2:4000
#  - iOS simulator: http://localhost:4000
#  - Physical phone: http://<your-computer-LAN-IP>:4000  ("localhost" on a phone is the phone itself)
EXPO_PUBLIC_API_URL=https://9drive.example.com
