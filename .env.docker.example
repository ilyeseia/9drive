# 9Drive Docker environment template
# Copy to `.env` :   cp .env.docker.example .env   (PowerShell: Copy-Item .env.docker.example .env)
#
# Every secret below is REQUIRED and has NO insecure default on purpose.
# Generate them with:
#   Node:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   PS:    -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })

# --- PostgreSQL (internal only, never published to the host) ---------------
POSTGRES_DB=9drive
POSTGRES_USER=9drive
POSTGRES_PASSWORD=
# legacy aliases (ignored, kept for older docs/scripts)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- Redis (internal only) -------------------------------------------------
REDIS_PASSWORD=

# --- Application secrets (REQUIRED, >= 32 chars, no placeholders) ----------
JWT_ACCESS_SECRET=
TOKEN_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# --- URLs ------------------------------------------------------------------
# PUBLIC_BASE_URL: where browsers reach the app (used to build OAuth redirects)
PUBLIC_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Bind for the frontend container. Use 127.0.0.1:5173 to keep it loopback-only,
# or a tailscale IP to expose it on your tailnet only.
FRONTEND_PORT_BIND=5173
# Empty = SPA calls same-origin /api/* (recommended, works behind any host/port)
VITE_API_URL=

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=1073741824
UPLOAD_SPOOL_MAX_BYTES=53687091200
INLINE_UPLOAD_MAX_BYTES=8388608

# --- Proxy -----------------------------------------------------------------
# 1 when behind nginx/reverse proxy, 0 when directly exposed
TRUST_PROXY_HOPS=1

# --- Google OAuth (optional; sign-in + Drive connect unavailable until set) -
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty to derive from PUBLIC_BASE_URL:
#   ${PUBLIC_BASE_URL}/api/connected-accounts/google/callback
GOOGLE_REDIRECT_URI=

# --- Dropbox OAuth (optional; Connect Dropbox unavailable until set) --------
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Leave empty to derive from PUBLIC_BASE_URL:
#   ${PUBLIC_BASE_URL}/api/connected-accounts/dropbox/callback
DROPBOX_REDIRECT_URI=

# --- reCAPTCHA (optional; registration captcha off when both keys empty) ----
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=

# --- SSRF guard ------------------------------------------------------------
# true only for homelab http endpoints you control
ALLOW_INSECURE_ENDPOINTS=false
# comma-separated hostnames allowed even if they resolve privately
SSRF_ALLOWLIST=

# --- Worker ----------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY_TRANSFER=2
WORKER_CONCURRENCY_SYNC=2
WORKER_CONCURRENCY_MAINTENANCE=1
WORKER_CONCURRENCY_REPLICATION=1
WORKER_CONCURRENCY_MIGRATION=1
WORKER_CONCURRENCY_WEBHOOK=2
WORKER_CONCURRENCY_RETRY=1

# --- Frontend build args (Vite embeds these at build time) -----------------
VITE_ALLOWED_REDIRECT_HOSTS=accounts.google.com
VITE_ENABLE_OFFICE_PREVIEW=false
